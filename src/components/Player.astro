---
// The "What I listen to" player from the reference mock (FR-08): play/pause, the song as a 12-cell
// fourteen-segment marquee, elapsed time, and the DIAL FX toggle. With more than one song it is a playlist:
// previous, next, and a list of the songs that opens above the player (a popover), each with its colour.
// Rendered only when src/data/tracks.ts lists a song, and hidden until src/scripts/player.ts wires it (it
// needs the script). No audio loads before the visitor's first click or tap.
import type { Track } from '../data/tracks';
import { RADIO_COLOR, marqueeCells, timeCells } from '../lib/sound';
import { ui } from '../lib/ui';

interface Props {
  tracks: Track[];
}

const { tracks } = Astro.props;
const songs = tracks.map((t) => ({
  ...t,
  marquee: t.artist ? `${t.artist} - ${t.title}` : t.title,
  name: [t.title, t.artist, t.credit].filter(Boolean).join(', '),
  color: t.color ?? RADIO_COLOR,
}));
const first = songs[0];
const many = songs.length > 1;
---

<section class:list={['player', { many }]} aria-label={ui.listen} data-player hidden>
  <button class="pbtn" type="button" data-play aria-label={ui.play}>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 4v16l13-8z"></path></svg>
  </button>
  <div class="ptxt">
    <span class="seg s14 marq" aria-hidden="true"
      ><span class="g">~~~~~~~~~~~~</span><span class="l" data-marquee>{marqueeCells(first.marquee, 0)}</span></span
    >
    <span class="pcap">
      <span class="sr-only" data-now>{ui.track}: {first.name}</span>
      <span aria-hidden="true">{ui.listen}</span>
      <span class="seg ptime" aria-hidden="true"><span class="g">88:88</span><span class="l" data-time>{timeCells(0)}</span></span>
    </span>
  </div>
  {
    many && (
      <div class="pnav">
        <button class="ibtn pstep" type="button" data-prev aria-label={ui.previousSong}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 5h2.5v14H6zM19 5v14L9 12z" /></svg>
        </button>
        <button class="ibtn pstep" type="button" data-next aria-label={ui.nextSong}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15.5 5H18v14h-2.5zM5 5v14l10-7z" /></svg>
        </button>
        <button class="ibtn" type="button" data-list-button aria-label={ui.playlist} popovertarget="playlist">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 6h16v2.2H4zM4 11h16v2.2H4zM4 16h10v2.2H4z" /></svg>
        </button>
      </div>
    )
  }
  <button class="mini" type="button" data-fx aria-pressed="false"><i aria-hidden="true"></i>{ui.dialFx}</button>
  <div class="plist" id="playlist" popover data-list>
    <p class="phead" aria-hidden="true">{ui.playlist}</p>
    <ol aria-label={ui.playlist}>
      {
        songs.map((t, i) => (
          <li>
            <button
              type="button"
              data-track={i}
              data-src={t.src}
              data-marquee={t.marquee}
              data-name={t.name}
              data-lit={t.color.lit}
              data-ground={t.color.ground}
              aria-current={i === 0 ? 'true' : undefined}
            >
              <i aria-hidden="true" style={`--c:${t.color.lit}`} />
              <span class="pt">{t.title}</span>
              {t.artist && <span class="pa">{t.artist}</span>}
            </button>
          </li>
        ))
      }
    </ol>
  </div>
  <audio preload="none"></audio>
</section>

<style>
  .player {
    flex: none;
    margin-inline-start: auto;
    height: 76px;
    display: grid;
    grid-template-columns: auto auto auto;
    grid-auto-flow: column;
    align-items: center;
    gap: 16px;
    padding-inline: 10px 16px;
    border-radius: 10px;
    background: rgba(24, 22, 21, 0.94);
    box-shadow: inset 0 0 0 1px var(--rule);
  }
  .player[hidden] {
    display: none;
  }
  .pbtn {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--rubber);
    box-shadow:
      0 3px 0 #0a0908,
      0 5px 10px rgba(0, 0, 0, 0.5);
    display: grid;
    place-items: center;
  }
  .pbtn:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 #0a0908;
  }
  .pbtn svg {
    width: 20px;
    height: 20px;
    fill: var(--text);
  }
  .ptxt {
    display: grid;
    gap: 6px;
  }
  .marq {
    font-family: var(--font-seg14);
    font-size: 20px;
    letter-spacing: 0.04em;
  }
  .pcap {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--quiet);
  }
  .ptime {
    font-family: var(--font-seg7);
    font-size: 15px;
    letter-spacing: normal;
  }
  /* A 44px target around the small label and lamp. */
  .mini {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding-inline: 2px;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.2em;
    color: var(--label);
  }
  .mini:hover {
    color: var(--text);
  }
  .mini i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--lamp-off);
  }
  .mini[aria-pressed='true'] i {
    background: var(--lit);
  }

  /* Previous, next and the list: 44px targets with an 18px icon. */
  .pnav {
    display: flex;
    margin-inline: -10px;
  }
  .ibtn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 6px;
  }
  .ibtn svg {
    width: 18px;
    height: 18px;
    fill: var(--label);
  }
  .ibtn:hover svg {
    fill: var(--text);
  }
  .ibtn:active svg {
    transform: translateY(1px);
  }

  /* The list: a popover above the player (src/scripts/player.ts places it), a sheet above the phone's bar. */
  .plist {
    position: fixed;
    inset: auto;
    margin: 0;
    width: min(360px, calc(100vw - 16px));
    max-height: min(60dvh, 440px);
    overflow: auto;
    padding: 6px;
    border: 0;
    border-radius: 10px;
    background: #181615;
    color: var(--text);
    box-shadow:
      inset 0 0 0 1px var(--rule),
      0 18px 40px rgba(0, 0, 0, 0.55);
    scrollbar-width: thin;
    scrollbar-color: #3a3330 transparent;
  }
  .plist::backdrop {
    background: transparent;
  }
  .phead {
    padding: 10px 12px 6px;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--quiet);
  }
  .plist ol {
    list-style: none;
  }
  .plist button {
    display: grid;
    grid-template-columns: 10px minmax(0, 1fr);
    align-items: center;
    column-gap: 14px;
    row-gap: 2px;
    width: 100%;
    min-height: 54px;
    padding: 8px 12px;
    border-radius: 6px;
    text-align: start;
  }
  .plist button:not([aria-current]):hover {
    background: #221f1d;
  }
  .plist i {
    grid-row: span 2;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--c);
  }
  .pt {
    font-weight: 600;
    font-size: 17px;
    line-height: 1.2;
    color: var(--text);
  }
  .pa {
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--quiet);
  }
  /* The song playing (or about to): its title in the LED colour (every song colour is at least 4.7:1 on the
     list's background, so the row stays untinted) and a ring around its dot. */
  .plist [aria-current='true'] .pt {
    color: var(--lit);
  }
  .plist [aria-current='true'] i {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 35%, transparent);
  }

  /* Tablet and phone: the compact player of the phone mock (docs/design/reference/phone-mock.html). On a
     tablet it fills the footer row under the hint; on a phone it is a bar fixed to the bottom. */
  @media (max-width: 959px), (orientation: landscape) and (max-height: 520px) and (pointer: coarse) {
    .player {
      width: 100%;
      height: 64px;
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 12px;
      padding-inline: 10px 8px;
    }
    .pbtn {
      width: 44px;
      height: 44px;
    }
    .pbtn svg {
      width: 17px;
      height: 17px;
    }
    .ptxt {
      gap: 5px;
      min-width: 0;
    }
    .marq {
      font-size: 15px;
    }
    .pcap {
      gap: 10px;
      letter-spacing: 0.18em;
      white-space: nowrap;
    }
    .ptime {
      font-size: 12px;
    }
    .mini {
      padding-inline: 8px 4px;
      letter-spacing: 0.18em;
    }
  }
  /* Phone: a slim bar fixed to the bottom of the screen, under the thumb, clear of the home indicator. The
     list button stays; previous and next are in the list (a tap on a song plays it). */
  @media (max-width: 699px), (orientation: landscape) and (max-height: 520px) and (pointer: coarse) {
    .pstep {
      display: none;
    }
    .pnav {
      margin-inline: -4px;
    }
    .player {
      position: fixed;
      z-index: 20;
      inset-inline: 0;
      bottom: 0;
      width: auto;
      height: calc(64px + env(safe-area-inset-bottom));
      margin: 0;
      padding: 0 max(10px, env(safe-area-inset-right)) env(safe-area-inset-bottom) max(10px, env(safe-area-inset-left));
      border-radius: 0;
      direction: ltr;
      background: #181615;
      box-shadow:
        inset 0 1px 0 var(--rule),
        0 -10px 24px rgba(0, 0, 0, 0.45);
    }
  }
  @media (orientation: landscape) and (max-height: 520px) and (pointer: coarse) {
    .player {
      height: calc(56px + env(safe-area-inset-bottom));
    }
  }
  /* A window under 400px tall in the phone layout, with a mouse: a desktop zoomed to 200–400%. A fixed bar
     would cover too much of it, so the player sits at the end of the page, as on a tablet (and there is no
     dock: src/scripts/dock.ts). Phones never match: upright they are taller, on their side they are touch. */
  @media (max-width: 699px) and (max-height: 399px) and (pointer: fine) {
    .player {
      position: static;
      width: 100%;
      height: 64px;
      padding: 0;
      padding-inline: 10px 8px;
      border-radius: 10px;
      /* In the page like the tablet's player, so it follows the page's direction (the bar is ltr). */
      direction: inherit;
      background: rgba(24, 22, 21, 0.94);
      box-shadow: inset 0 0 0 1px var(--rule);
    }
  }
</style>
