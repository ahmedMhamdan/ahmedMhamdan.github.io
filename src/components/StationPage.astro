---
// Readable baseline for every station: real HTML that works without JavaScript.
// The radio (left) and LED wall (right) from the reference mock enhance this page;
// they never replace the text. See docs/PLAN.md, phases 2 to 4.
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import { BANDS } from '../lib/dial';
import { stationPath, type Station } from '../lib/stations';

interface Props {
  station: Station;
  stations: Station[];
}

const { station, stations } = Astro.props;
const { data } = station;
const { Content } = await render(station);
const freq = data.freq.toFixed(1).padStart(5, '!'); // "!" = blank seven-segment cell
---

<div class="page">
  <nav class="dial" aria-label="Stations">
    <p class="plate"><b>AHMED HAMDAN</b><span>CYBERSECURITY · FULL-STACK</span></p>

    <p class="readout" aria-hidden="true">
      <span class="fm">FM</span>
      <span class="seg digits"><span class="g">188.8</span><span class="l">{freq}</span></span>
      <span class="mhz">MHz</span>
    </p>

    <ol class="bands">
      {
        BANDS.map((band, i) => (
          <li class:list={['band', { on: band.id === data.band }]}>
            <span class="bandkey">
              <b>{i + 1}</b>
              {band.label}
            </span>
            <ul>
              {stations
                .filter((s) => s.data.band === band.id)
                .map((s) => (
                  <li>
                    <a href={stationPath(s.id)} aria-current={s.id === station.id ? 'page' : undefined}>
                      <span class="freq">{s.data.freq.toFixed(1)}</span>
                      {s.data.key}
                    </a>
                  </li>
                ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </nav>

  <main class="program">
    <article class="panel">
      <p class="k">{data.kicker ?? data.band.toUpperCase()}</p>
      <h1 class="big">
        {data.title}
        {data.placeholder && <span class="draft">PLACEHOLDER</span>}
      </h1>
      {data.lede && <p class="lede">{data.lede}</p>}
      {data.image && data.imageAlt && <Image src={data.image} alt={data.imageAlt} class="pic" />}
      <div class:list={['body', { poem: data.band === 'poetry' }]}>
        <Content />
      </div>
      {
        data.href && (
          <p class="acts">
            <a class="act lit" href={data.href} rel="me noopener">
              {data.title} ↗
            </a>
          </p>
        )
      }
    </article>
  </main>
</div>

<style>
  .page {
    display: grid;
    grid-template-columns: minmax(280px, 400px) 1fr;
    min-height: 100dvh;
  }
  .dial {
    padding: 32px 28px;
    background: var(--case);
    display: grid;
    align-content: start;
    gap: 24px;
  }
  .plate {
    display: grid;
    gap: 4px;
  }
  .plate b {
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.26em;
    color: #d9cdc6;
  }
  .plate span {
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--quiet);
  }
  .readout {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    padding: 14px 18px;
    border-radius: 10px;
    background: #0b0a09;
    box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.9);
  }
  .fm,
  .mhz {
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.2em;
    padding-bottom: 6px;
  }
  .fm {
    color: var(--lit);
  }
  .mhz {
    color: var(--quiet);
  }
  .digits {
    font-family: var(--font-seg7);
    font-size: 44px;
  }
  .bands,
  .bands ul {
    list-style: none;
  }
  .bands {
    display: grid;
    gap: 14px;
  }
  .bandkey {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--quiet);
  }
  .bandkey b {
    font-family: var(--font-seg7);
    font-weight: 400;
    font-size: 13px;
    color: var(--quiet);
  }
  .band.on .bandkey {
    color: var(--text);
  }
  .band.on .bandkey b {
    color: var(--lit);
  }
  .bands ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin-top: 6px;
    padding-left: 22px;
  }
  .bands a {
    display: inline-flex;
    gap: 8px;
    align-items: baseline;
    padding: 6px 0;
    text-decoration: none;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--label);
  }
  .bands a:hover {
    color: #fff;
  }
  .bands a[aria-current='page'] {
    color: var(--amber);
  }
  .freq {
    font-family: var(--font-seg7);
    font-size: 12px;
    color: var(--quiet);
  }
  .program {
    padding: 48px;
    min-width: 0;
  }
  .panel {
    max-width: 760px;
    padding: 28px 32px;
    border-radius: 10px;
    background: rgba(18, 17, 16, 0.9);
    box-shadow: inset 0 0 0 1px var(--rule);
  }
  .big {
    font-weight: 600;
    font-size: 2.6rem;
    line-height: 1.02;
    color: var(--text);
    margin: 6px 0 12px;
  }
  .lede {
    font-size: 1.3rem;
    line-height: 1.45;
    color: var(--text);
    max-width: 52ch;
  }
  .pic {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 20px;
    border-radius: 4px;
  }
  .body {
    margin-top: 16px;
    font-size: 1.15rem;
    line-height: 1.55;
    color: #d8ccc5;
    max-width: 62ch;
  }
  .body :global(ul) {
    list-style: none;
    display: grid;
  }
  .body :global(li) {
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--text);
  }
  .body :global(strong) {
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--quiet);
    margin-right: 12px;
  }
  .body.poem {
    font-style: italic;
    font-weight: 300;
    font-size: 1.55rem;
    line-height: 1.6;
    color: var(--text);
    max-width: 40ch;
  }
  .acts {
    margin-top: 20px;
  }
  .act {
    display: inline-grid;
    place-items: center;
    height: 44px;
    padding: 0 18px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .act.lit {
    background: var(--lit);
    color: #140806;
  }

  @media (max-width: 860px) {
    .page {
      grid-template-columns: 1fr;
    }
    .program {
      padding: 20px 16px 40px;
    }
    .panel {
      padding: 22px 20px;
    }
    .big {
      font-size: 2rem;
    }
  }
</style>
