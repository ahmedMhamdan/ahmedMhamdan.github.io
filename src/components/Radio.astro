---
// The radio object from the reference mock (docs/design/reference/g-radio-wall.html), rendered at rest:
// tuned and locked to the current station. Works without JavaScript: band keys, station marks,
// preset keys and seek buttons are plain links. Ghost cells, scale and speaker are aria-hidden.
import { BANDS, bandIndex, rowPosition } from '../lib/dial';
import { MARK_LOCK, MARK_OFF, MARK_ON, TICK_OFF, TICK_ON, W, H, markAt, needlePaths, needleX, tickPath } from '../lib/scale';
import { SOUND, volumeAngle } from '../lib/sound';
import { freqCells, keyCells, knobAngle } from '../lib/tuning';
import {
  firstOfBand,
  freqText,
  neighbours,
  spokenName,
  stationPath,
  type Station,
} from '../lib/stations';
import { ui } from '../lib/ui';

interface Props {
  station: Station;
  stations: Station[];
}

const { station, stations } = Astro.props;
const f = station.data.freq;
const activeRow = bandIndex(station.data.band);
const { prev, next } = neighbours(stations, station.id);

// Seven/fourteen-segment text: "!" is a blank cell the same width as a lit one.
const digits = freqCells(f);
const alpha = keyCells(station.data.key);

// Dial scale (src/lib/scale.ts): ticks, station marks and the needle, tuned to this station.
const ticks = BANDS.map((_, i) => ({ d: tickPath(i), on: i === activeRow }));
const marks = stations.map((s) => ({
  id: s.id,
  ...markAt(s.data.freq),
  fill: s.id === station.id ? MARK_LOCK : bandIndex(s.data.band) === activeRow ? MARK_ON : MARK_OFF,
}));
const needle = needlePaths(activeRow);
const n2 = (v: number) => +v.toFixed(2);

// Speaker grille: rings of holes r = 12…92 step 10, about one hole per 10px, alternate rings offset.
const holes: { cx: string; cy: string }[] = [];
for (let r = 12; r <= 96; r += 10) {
  const n = Math.max(6, Math.round((2 * Math.PI * r) / 10));
  for (let i = 0; i < n; i++) {
    const a = (i / n) * 2 * Math.PI + ((r / 10) % 2) * 0.15;
    holes.push({ cx: (106 + r * Math.cos(a)).toFixed(1), cy: (106 + r * Math.sin(a)).toFixed(1) });
  }
}

---

<header class="stand">
  <div class="radio" data-radio>
    <div class="antenna rx" aria-hidden="true"><span class="tip"></span></div>
    <div class="handle" aria-hidden="true"></div>
    {/* Preset keys repeat the band keys below for pointer users; the band keys carry the names. */}
    <div class="keys" aria-hidden="true">
      {
        BANDS.map((b, i) => {
          const first = firstOfBand(stations, b.id);
          return (
            <a class:list={['pk', { on: i === activeRow }]} href={first ? stationPath(first.id) : undefined} tabindex="-1">
              {i + 1}
            </a>
          );
        })
      }
    </div>

    <div class="case">
      <i class="screw s1" aria-hidden="true"></i><i class="screw s2" aria-hidden="true"></i>
      <i class="screw s3" aria-hidden="true"></i><i class="screw s4" aria-hidden="true"></i>

      <div class="lcd">
        <p class="sr-only" data-lcd-text>{ui.tunedTo} {freqText(f)} {ui.mhz}: {spokenName(station)}</p>
        <span class="fm" aria-hidden="true">{ui.fm}</span>
        <span class="seg digits" aria-hidden="true"><span class="g">188.8</span><span class="l">{digits}</span></span>
        <span class="mhz" aria-hidden="true">{ui.mhz}</span>
        <div class="stat" aria-hidden="true">
          <span class="seg alpha"><span class="g">~~~~~~~~~</span><span class="l">{alpha}</span></span>
          <div class="meters">
            <span class="lamp on" data-lamp="tuned">{ui.tuned}</span>
            <span class="lamp amber" data-lamp="afc">{ui.afc}</span>
            <span class="sigm">{Array.from({ length: 10 }, (_, i) => <i class:list={['on', { hi: i > 7 }]} />)}</span>
          </div>
        </div>
      </div>

      <nav class="dialwin" aria-label={ui.stations}>
        <svg class="scale" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
          {ticks.map((t) => <path data-ticks d={t.d} fill={t.on ? TICK_ON : TICK_OFF} />)}
          {marks.map((m) => <rect data-mark={m.id} x={m.x} y={m.y} width="5" height="6" fill={m.fill} />)}
          <g data-needle transform={`translate(${needleX(f)} 0)`}>
            <path d={needle.outRow} fill="rgba(255,59,31,.35)" />
            <path d={needle.inRow} fill="var(--lit)" />
          </g>
        </svg>
        <ol class="rows">
          {
            BANDS.map((b, i) => {
              const first = firstOfBand(stations, b.id);
              return (
                <li class:list={['row', { on: i === activeRow }]}>
                  <a class="bandkey" href={first ? stationPath(first.id) : undefined}>
                    <span class="sr-only">{ui.band} </span>
                    <b>{i + 1}</b>
                    <span>{b.label}</span>
                  </a>
                  <ul class="track">
                    {stations
                      .filter((s) => s.data.band === b.id)
                      .map((s) => (
                        <li>
                          <a
                            class:list={['stn', { lock: s.id === station.id }]}
                            href={stationPath(s.id)}
                            data-station={s.id}
                            style={`left:${n2(rowPosition(s.data.freq, s.data.band) * 100)}%`}
                            aria-current={s.id === station.id ? 'page' : undefined}
                          >
                            {s.data.key}
                            <span class="sr-only">, {freqText(s.data.freq)} {ui.mhz}</span>
                          </a>
                        </li>
                      ))}
                  </ul>
                </li>
              );
            })
          }
        </ol>
      </nav>

      <div class="plate"><b>{ui.siteName}</b><span>{ui.siteRole}</span></div>

      <div class="lower">
        <div class="spk" aria-hidden="true">
          {/* The cone: pulses with the music (src/scripts/readouts.ts). */}
          <svg class="cone" viewBox="0 0 212 212" focusable="false" data-cone>
            <g fill="#050404">
              {holes.map((h) => <circle cx={h.cx} cy={h.cy} r="2.6" />)}
              <circle cx="106" cy="106" r="5" />
            </g>
          </svg>
        </div>
        <div class="ctrls">
          {/* The tuner script turns the knob into a slider; the player script does the same for the volume
              knob, only when there is music (src/data/tracks.ts). */}
          <div class="knob" aria-hidden="true" data-knob>
            <div class="ring"></div>
            <div class="grip" style={`transform:rotate(${n2(knobAngle(f))}deg)`}></div>
          </div>
          <span class="klabel" aria-hidden="true">{ui.tuning}</span>
          <div class="sub">
            <a class="seek" data-seek="prev" href={stationPath(prev.id)} aria-label={`${ui.previousStation}: ${spokenName(prev)}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 4h3v16H5zM21 4v16L9 12z"></path></svg>
            </a>
            <div class="vol" aria-hidden="true" data-volume>
              <div class="grip" style={`transform:rotate(${volumeAngle(SOUND.volume)}deg)`}></div>
            </div>
            <a class="seek" data-seek="next" href={stationPath(next.id)} aria-label={`${ui.nextStation}: ${spokenName(next)}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M16 4h3v16h-3zM3 4v16l12-8z"></path></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  {
    /* Phones: once the dial scrolls away, its LCD docks at the top with the seek buttons, and a press on
       the LCD goes back up to the dial (src/scripts/dock.ts shows it; without the script it stays hidden). */
  }
  <div class="dock" data-dock hidden>
    <a class="seek" data-seek="prev" href={stationPath(prev.id)} aria-label={`${ui.previousStation}: ${spokenName(prev)}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 4h3v16H5zM21 4v16L9 12z"></path></svg>
    </a>
    <button class="mlcd" type="button" data-dock-top>
      <span class="sr-only">{ui.backToDial}</span>
      <span class="fm" aria-hidden="true">{ui.fm}</span>
      <span class="seg md" aria-hidden="true"><span class="g">188.8</span><span class="l" data-dock-freq>{digits}</span></span>
      <span class="seg ma" aria-hidden="true"><span class="g">~~~~~~~~~</span><span class="l" data-dock-key>{alpha}</span></span>
      <i class="mlamp on" aria-hidden="true" data-dock-lamp></i>
    </button>
    <a class="seek" data-seek="next" href={stationPath(next.id)} aria-label={`${ui.nextStation}: ${spokenName(next)}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M16 4h3v16h-3zM3 4v16l12-8z"></path></svg>
    </a>
  </div>
</header>

<style>
  /* Fit the whole radio (722px case + 196px antenna, handle and keys) into the viewport height.
     tan(atan2(a, b)) turns the ratio of two lengths into a plain number, so no fit() script is needed. */
  .stand {
    --fit: min(1, tan(atan2(100dvh - 30px, 918px)));
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: end center;
    padding-bottom: 24px;
    overflow: hidden;
  }
  /* The radio is a physical object with a left-to-right frequency scale (drawn in fixed
     coordinates above), so it keeps its shape in a right-to-left page; text inside still
     follows the bidi algorithm. Page and panel layouts around it use logical properties. */
  .radio {
    direction: ltr;
    position: relative;
    width: 452px;
    height: 722px;
    /* Stays centred even when the column is narrower than the unscaled radio. */
    margin-inline: calc((100% - 452px) / 2);
    /* Takes up only its scaled height, so a short screen never pushes its bottom out of sight. */
    margin-block-start: calc(722px * (var(--fit) - 1));
    transform-origin: bottom center;
    transform: scale(var(--fit));
  }

  .antenna {
    position: absolute;
    right: 52px;
    bottom: calc(100% - 8px);
    width: 7px;
    height: 180px;
    transform-origin: 50% 100%;
    transform: rotate(-13deg);
    background: linear-gradient(90deg, #4a4642, #bdb7b0 45%, #6d6863 60%, #3a3633);
    border-radius: 3px;
  }
  .antenna::before {
    content: '';
    position: absolute;
    inset-inline: -1px;
    top: 62px;
    height: 3px;
    background: #2a2725;
  }
  .antenna::after {
    content: '';
    position: absolute;
    left: 50%;
    top: -9px;
    width: 13px;
    height: 13px;
    margin-left: -6.5px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #e9e3dc, #77716b 70%);
  }
  .antenna .tip {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: -4px;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    background: var(--lit);
    opacity: 0;
    transition: opacity 0.15s;
  }
  .antenna.rx .tip {
    opacity: 1;
  }
  .handle {
    position: absolute;
    inset-inline: 34px;
    bottom: calc(100% - 10px);
    height: 84px;
    border: 16px solid #2c2724;
    border-bottom: 0;
    border-radius: 46px 46px 0 0;
    box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.05);
  }

  .keys {
    position: absolute;
    inset-inline: 96px;
    bottom: calc(100% - 2px);
    display: flex;
    gap: 6px;
    justify-content: center;
  }
  .pk {
    width: 44px;
    height: 20px;
    border-radius: 5px 5px 0 0;
    background: linear-gradient(#3a3532, #26221f);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    font-family: var(--font-seg7);
    font-size: 12px;
    color: var(--key-digit);
    text-decoration: none;
    display: grid;
    place-items: center;
    transition:
      transform 0.12s cubic-bezier(0.2, 0.9, 0.3, 1),
      height 0.12s;
  }
  .pk.on {
    transform: translateY(7px);
    color: var(--lit);
    background: linear-gradient(#27231f, #181513);
  }

  .case {
    position: absolute;
    inset: 0;
    border-radius: 28px;
    background: linear-gradient(180deg, #2a2522, #1c1917 58%, #171412);
    box-shadow:
      0 30px 60px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      inset 0 -3px 0 rgba(0, 0, 0, 0.35);
    padding: 22px 22px 24px;
    display: grid;
    grid-template-rows: 144px 204px 30px minmax(0, 1fr);
    gap: 12px;
  }
  .screw {
    position: absolute;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #57514c, #2a2623);
  }
  .screw::after {
    content: '';
    position: absolute;
    left: 2px;
    right: 2px;
    top: 5px;
    height: 1px;
    background: #171412;
    transform: rotate(35deg);
  }
  .s1 {
    left: 10px;
    top: 10px;
  }
  .s2 {
    right: 10px;
    top: 10px;
  }
  .s3 {
    left: 10px;
    bottom: 10px;
  }
  .s4 {
    right: 10px;
    bottom: 10px;
  }

  /* LCD */
  .lcd {
    border-radius: 10px;
    background: #0b0a09;
    box-shadow:
      inset 0 2px 10px rgba(0, 0, 0, 0.9),
      0 1px 0 rgba(255, 255, 255, 0.05);
    padding: 12px 18px;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 16px;
    row-gap: 8px;
    align-items: end;
  }
  .fm {
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.2em;
    color: var(--lit);
    padding-bottom: 10px;
  }
  .digits {
    font-family: var(--font-seg7);
    font-size: 56px;
  }
  .mhz {
    justify-self: end;
    align-self: start;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.3em;
    color: var(--quiet);
    grid-column: 2;
    grid-row: 1;
    padding-top: 4px;
  }
  .stat {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .alpha {
    font-family: var(--font-seg14);
    font-size: 22px;
    letter-spacing: 0.04em;
  }
  .meters {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .lamp {
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.18em;
    color: var(--dimlabel);
  }
  .lamp.on {
    color: var(--lit);
  }
  .lamp.amber.on {
    color: var(--amber);
  }
  .sigm {
    display: flex;
    gap: 2px;
  }
  .sigm i {
    width: 5px;
    height: 13px;
    background: var(--ghost);
    border-radius: 1px;
  }
  .sigm i.on {
    background: var(--lit);
  }
  .sigm i.hi.on {
    background: var(--amber);
  }

  /* Dial window. It is also a touch surface: drag along a row to tune (src/scripts/tuner.ts), while a
     vertical swipe still scrolls the page. */
  .dialwin {
    position: relative;
    border-radius: 8px;
    background: #0d0c0b;
    box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.85);
    padding: 6px 12px;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }
  .dialwin[data-drag] {
    cursor: ew-resize;
  }
  .dialwin[data-drag] a {
    cursor: pointer;
  }
  .scale {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .rows {
    list-style: none;
    height: 100%;
    display: grid;
    grid-template-rows: repeat(5, minmax(0, 1fr));
  }
  .row {
    display: grid;
    grid-template-columns: 78px 1fr;
    min-height: 0;
  }
  .bandkey {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }
  .bandkey b {
    font-family: var(--font-seg7);
    font-size: 13px;
    color: var(--dimlabel);
    font-weight: 400;
  }
  .bandkey span:not(.sr-only) {
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--quiet);
  }
  .row.on .bandkey b {
    color: var(--lit);
  }
  .row.on .bandkey span {
    color: var(--text);
  }
  .bandkey:hover span {
    color: #fff;
  }
  .track {
    position: relative;
    list-style: none;
  }
  .stn {
    position: absolute;
    top: 1px;
    transform: translateX(-50%);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--quiet);
    white-space: nowrap;
    padding: 0 2px;
    text-decoration: none;
  }
  .row.on .stn {
    color: var(--label);
  }
  .stn:hover {
    color: #fff;
  }
  .stn.lock,
  .row.on .stn.lock {
    color: var(--amber);
  }

  /* Name plate */
  .plate {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 6px;
    text-transform: uppercase;
  }
  .plate b {
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.26em;
    color: #d9cdc6;
    white-space: nowrap;
  }
  .plate span {
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--quiet);
    white-space: nowrap;
  }

  /* Speaker and controls */
  .lower {
    display: grid;
    grid-template-columns: 212px 1fr;
    gap: 18px;
    align-items: center;
    min-height: 0;
  }
  .spk {
    position: relative;
    width: 212px;
    height: 212px;
    border-radius: 50%;
    background: radial-gradient(circle, #171412 0 60%, #100e0d 61%);
    box-shadow:
      inset 0 3px 12px rgba(0, 0, 0, 0.8),
      0 1px 0 rgba(255, 255, 255, 0.05);
  }
  .spk svg {
    position: absolute;
    inset: 0;
  }
  /* Its own layer, so the pulse never repaints the grille. */
  .cone {
    transform-origin: 50% 50%;
    will-change: transform;
  }
  .ctrls {
    display: grid;
    justify-items: center;
    gap: 12px;
  }
  .knob {
    width: 122px;
    height: 122px;
    border-radius: 50%;
    position: relative;
    background: radial-gradient(circle at 40% 34%, #433d39, #211d1a 64%, #161311);
    box-shadow:
      0 8px 16px rgba(0, 0, 0, 0.6),
      inset 0 1px 1px rgba(255, 255, 255, 0.1);
  }
  .knob .grip {
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }
  .knob .grip::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 11px;
    width: 9px;
    height: 9px;
    margin-left: -4.5px;
    border-radius: 50%;
    background: var(--lit);
  }
  .knob .ring {
    position: absolute;
    inset: 14px;
    border-radius: 50%;
    border: 1px solid #3a3431;
  }
  /* The tuner script makes the knob a slider you can drag, scroll and key. */
  .knob[role='slider'] {
    cursor: grab;
    touch-action: none;
    user-select: none;
  }
  .knob[role='slider']:active {
    cursor: grabbing;
  }
  .klabel {
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.24em;
    color: var(--quiet);
  }
  .sub {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .seek {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--rubber);
    box-shadow:
      0 3px 0 #0a0908,
      0 4px 8px rgba(0, 0, 0, 0.5);
    display: grid;
    place-items: center;
  }
  .seek:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 #0a0908;
  }
  .seek svg {
    width: 15px;
    height: 15px;
    fill: var(--label);
  }
  .vol {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    position: relative;
    background: radial-gradient(circle at 40% 34%, #433d39, #1d1a17 66%);
    box-shadow: 0 5px 10px rgba(0, 0, 0, 0.55);
  }
  .vol .grip {
    position: absolute;
    inset: 0;
  }
  /* The player script makes the volume knob a slider you can turn and key. */
  .vol[role='slider'] {
    cursor: grab;
    touch-action: none;
    user-select: none;
  }
  .vol[role='slider']:active {
    cursor: grabbing;
  }
  .vol .grip::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 6px;
    width: 3px;
    height: 11px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: var(--text);
  }

  /* Interim narrow layout until the phone design (plan Phase 5): the radio fits the width. */
  @media (max-width: 959px) {
    .stand {
      --fit: min(1, tan(atan2(100vw - 24px, 452px)));
      height: calc(918px * var(--fit) + 24px);
    }
  }

  /* The docked LCD exists for phones only. */
  .dock {
    display: none;
  }

  /* Phone (plan Phase 5; docs/design/reference/phone-mock.html): the radio becomes a head unit across the
     top of the page: preset keys and a short antenna, the LCD, the five-row dial full width (scaled as one
     drawing, so the scale and the labels stay aligned), and the name plate between the seek buttons. No
     handle, speaker, tuning knob or volume knob: the dial is dragged instead, and phones have volume
     buttons. The page scrolls; the docked LCD and the player bar stay on screen. */
  @media (max-width: 699px), (orientation: landscape) and (max-height: 520px) and (pointer: coarse) {
    .stand {
      --fit: 1;
      display: block;
      /* The desktop's centring would also shrink the radio in block layout. */
      place-items: normal;
      height: auto;
      padding: env(safe-area-inset-top) 10px 0;
      overflow: visible;
    }
    .radio {
      width: auto;
      height: auto;
      margin-inline: 0;
      padding-top: 60px;
      transform: none;
    }
    .antenna {
      top: 12px;
      bottom: auto;
      right: 46px;
