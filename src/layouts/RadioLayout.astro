---
// Every station page: the radio on the left, the program area on the right (reference mock).
// Complete without JavaScript; the tuner script (src/scripts/main.ts) enhances this markup.
import Program from '../components/Program.astro';
import Radio from '../components/Radio.astro';
import { stationInfo, type Station } from '../lib/stations';
import { ui } from '../lib/ui';
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  station: Station;
  stations: Station[];
}

const { title, description, station, stations } = Astro.props;

// The station list for the tuner, in dial order. "<" is escaped so the JSON can never close the tag.
const infos = await Promise.all(stations.map(stationInfo));
const data = JSON.stringify({ current: station.id, stations: infos }).replace(/</g, '\\u003c');
---

<Base title={title} description={description}>
  <a class="skip" href="#content">{ui.skipToContent}</a>
  <div class="page">
    <Radio station={station} stations={stations} />
    <Program station={station} stations={stations} />
  </div>
  {/* Announces the station once the dial settles on it (never every frame). */}
  <p class="sr-only" aria-live="polite" data-tuner-status></p>
  <script type="application/json" id="radio-data" is:inline set:html={data} />
  <script>
    import '../scripts/main';
  </script>
</Base>

<style>
  .page {
    position: fixed;
    inset: 0;
    display: grid;
    grid-template-columns: 520px minmax(0, 1fr);
  }
  /* Interim narrow layout until the tablet design (plan Phase 5): radio, then program, page scrolls.
     Phones get their own layout from the same rules (Radio.astro, Program.astro, Player.astro). */
  @media (max-width: 959px) {
    .page {
      position: static;
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* Phone on its side: the head unit on the left, the program on the right. */
  @media (orientation: landscape) and (max-height: 520px) and (pointer: coarse) {
    .page {
      position: static;
      grid-template-columns: minmax(330px, 42%) minmax(0, 1fr);
      column-gap: 12px;
    }
  }
  /* Phones: the page ends above the fixed player bar. */
  @media (max-width: 699px), (orientation: landscape) and (max-height: 520px) and (pointer: coarse) {
    :global(body:has(.player:not([hidden]))) {
      padding-bottom: calc(64px + env(safe-area-inset-bottom) + 8px);
    }
  }
  /* On its side the bar is 56px, and the head unit fills the height above it exactly, so the page must
     end right at the bar or the sticky head unit is nudged up at the bottom of the page. */
  @media (orientation: landscape) and (max-height: 520px) and (pointer: coarse) {
    :global(body:has(.player:not([hidden]))) {
      padding-bottom: calc(56px + env(safe-area-inset-bottom));
    }
  }
</style>
