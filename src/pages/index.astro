---
import RadioLayout from '../layouts/RadioLayout.astro';
import { getStations, HOME_ID } from '../lib/stations';

const stations = await getStations();
const station = stations.find((s) => s.id === HOME_ID)!;
---

<RadioLayout
  title="Ahmed Hamdan · Cybersecurity graduate and full-stack developer"
  description={station.data.lede ?? 'Cybersecurity graduate and full-stack developer.'}
  station={station}
  stations={stations}
/>
