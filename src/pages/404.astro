---
import Base from '../layouts/Base.astro';
---

<Base title="No signal · Ahmed Hamdan" description="Nothing is broadcasting on this frequency.">
  <main class="nosig">
    <p class="seg readout" aria-hidden="true"><span class="g">~~~~~~~~~</span><span class="l">NO!SIGNAL</span></p>
    <h1>Nothing is broadcasting here.</h1>
    <p><a href="/">Back to the dial</a></p>
  </main>
</Base>

<style>
  .nosig {
    min-height: 100dvh;
    display: grid;
    place-content: center;
    gap: 16px;
    padding: 24px;
    text-align: center;
  }
  .readout {
    font-family: var(--font-seg14);
    font-size: clamp(28px, 7vw, 56px);
    margin-inline: auto;
  }
  h1 {
    font-weight: 600;
    font-size: 1.6rem;
    color: var(--text);
  }
  /* The panel's rubber button (panel.css, .act): amber is kept for lock, AFC and focus. */
  a {
    display: inline-grid;
    place-items: center;
    height: 44px;
    padding: 0 18px;
    border-radius: 6px;
    background: var(--rubber);
    box-shadow:
      0 3px 0 #0a0908,
      0 5px 10px rgba(0, 0, 0, 0.5);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    font-size: 13px;
    color: var(--text);
  }
  a:hover {
    color: #fff;
  }
  a:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 #0a0908;
  }
</style>
